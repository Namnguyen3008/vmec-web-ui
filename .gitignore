# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# documentation & sensitive docs (never commit to git)
docs/
/docs/
*.docx
*.doc
*.pptx
*.pdf

# dataset & raw data files (never commit to git)
data/
/data/
dataset/
/dataset/
*.csv
*.tsv
*.parquet
*.jsonl
*.xlsx
*.xls
*.sqlite
*.sqlite3
*.db

# logs & caches
*.log
npm-debug.log*
yarn-debug.log*
.idea/
.vscode/
Thumbs.db
*.bak
*.tmp

# serena local agent workspace (never commit to git)
.serena/
/.serena/
.serena*

# python backend
backend/.venv/
backend/.env
backend/.env.*
!backend/.env.example
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.coverage

