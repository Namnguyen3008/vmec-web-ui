# ============================================
# VMEC Healthcare Dedicated AI Platform — .env.example
# ============================================
# Copy this file to .env or backend/.env and fill in your keys

# ---- Application Settings ----
APP_NAME=VMEC-Dedicated-Backend
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://vmec-healthcare-web.vercel.app

# ---- Google Gemini Generative AI (Rotation Pool: 7 Keys) ----
GEMINI_API_KEY=AIzaSy...
GEMINI_API_KEY_2=AIzaSy...
GEMINI_API_KEY_3=AIzaSy...
GEMINI_API_KEY_4=AIzaSy...
GEMINI_API_KEY_5=AIzaSy...
GEMINI_API_KEY_6=AIzaSy...
GEMINI_API_KEY_7=AIzaSy...
GEMINI_GENERATIVE_MODEL_1=gemini-3.1-flash-lite
GEMINI_GENERATIVE_MODEL_2=gemini-3.5-flash-lite
GEMINI_CALL_TIMEOUT_SECONDS=30.0

# ---- Mistral Semantic Embeddings (Rotation Pool: 13 Keys) ----
MISTRAL_API_KEY=...
MISTRAL_API_KEY_2=...
MISTRAL_API_KEY_3=...
MISTRAL_API_KEY_4=...
MISTRAL_API_KEY_5=...
MISTRAL_API_KEY_6=...
MISTRAL_API_KEY_7=...
MISTRAL_API_KEY_8=...
MISTRAL_API_KEY_9=...
MISTRAL_API_KEY_10=...
MISTRAL_API_KEY_11=...
MISTRAL_API_KEY_12=...
MISTRAL_API_KEY_13=...
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_EMBEDDING_DIMENSIONS=1024

# ---- Supabase Cloud pgvector Knowledge Base ----
SUPABASE_URL=https://nntxlqchytvfmutmixea.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
RETRIEVAL_CANDIDATE_LIMIT=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.40

# ---- Azure Cosmos DB Free Tier (Atomic Slot Hold & Session TTL) ----
AZURE_COSMOS_ENDPOINT=https://cosmos-vmec-ai-2026.documents.azure.com:443/
AZURE_COSMOS_KEY=...
AZURE_COSMOS_DATABASE=vmec_healthcare_db
AZURE_COSMOS_CONTAINER_SESSIONS=patient_sessions
AZURE_COSMOS_CONTAINER_SLOTS=slot_holds
AZURE_COSMOS_CONTAINER_RECORDS=medical_records
AZURE_COSMOS_CONTAINER_BOOKINGS=appointments
AZURE_COSMOS_CONTAINER_AUDIT=audit_logs
